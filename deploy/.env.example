# This is a template, not a usable credential file. Fill the empty fields locally.
# For an existing deployment, KEEP its account/password values and only add missing keys.
# Values containing $ or # should be single-quoted using Compose .env syntax.
MYSQL_ROOT_PASSWORD=
RESQ_DB_USERNAME=resq_app
RESQ_DB_PASSWORD=
RESQ_RABBITMQ_USERNAME=resq_app
RESQ_RABBITMQ_PASSWORD=
RESQ_PROD_JWT_SECRET_BASE64=

# Build a new tag; retain the old image for rollback.
RESQ_APP_IMAGE=resq:compose-local

# UTC matches the inspected dependency container's current system zone.
# Before migrating existing DATETIME data, verify the old application/DB convention.
RESQ_TIME_ZONE=UTC

# Local-only published ports. Internal service names/ports do not change.
RESQ_APP_PORT=8081
RESQ_MYSQL_PORT=3306
RESQ_REDIS_PORT=6379
RESQ_RABBITMQ_PORT=5672
RESQ_RABBITMQ_MANAGEMENT_PORT=15672
