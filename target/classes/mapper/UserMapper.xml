<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.resq.mapper.UserMapper">

    <!-- 数据库字段与 Java 属性的映射 -->
    <resultMap id="UserResultMap"
        type="com.resq.domain.User">

        <id property="id" column="id" />

        <result property="username"
            column="username" />

        <result property="passwordHash"
            column="password" />

        <result property="email"
            column="email" />

        <result property="createdAt"
            column="created_at" />

    </resultMap>

    <!-- 根据用户名查询 -->
    <select id="findByUsername"
        resultMap="UserResultMap"> SELECT id, username, password, email, created_at FROM `user`
        WHERE username = #{username} </select>

    <!-- 插入新用户 -->
    <insert id="insert"
        parameterType="com.resq.domain.User"
        useGeneratedKeys="true"
        keyProperty="id"> INSERT INTO `user` (username, password, email, created_at) VALUES
        (#{username}, #{passwordHash}, #{email}, #{createdAt}) </insert>
    <select id="findById" resultMap="UserResultMap"> SELECT id, username, password, email,
        created_at FROM `user` WHERE id = #{id} </select>
</mapper>